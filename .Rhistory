summary(output4)
output5 <- lm(vote ~ vet*age + educ + gender + race, data = pew, weights = WEIGHT_W153)
summary(output5)
output6 <- lm(vote ~ vet*educ + race + gender + age, data = pew, weights = WEIGHT_W153)
summary(output6)
