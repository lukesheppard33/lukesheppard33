output2 <- lm(vote ~ vet + age + educ + gender + race, data = pew, weights = WEIGHT_W153)
summary(output2)
#3
output3 <- glm(vote ~ vet + age + educ + gender + race, family=binomial(link="probit"), data = pew, weights = WEIGHT_W153)
summary(output3)
summary(margins(output3))
